# Application Configuration
APP_NAME="AI Company OS"
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
# Async engine for FastAPI application
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_company_os
# Sync engine for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_company_os

# Redis Configuration (for cache / queue coordination in later phases)
REDIS_URL=redis://localhost:6379/0
